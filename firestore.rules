rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles rules
    match /users/{userId} {
      allow read: if true; // Leaderboards need to be public
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId); // Account self-deletion (deleteUserAccount)
    }

    // Daily scores rules
    match /scores/{scoreId} {
      allow read: if true;
      // One immutable score per user per day:
      // - doc ID must be "{uid}_{date}" and match the payload
      // - score bounded to the legit range: (6 - attempts) * 100 + speed bonus (max 100)
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && scoreId == request.auth.uid + "_" + request.resource.data.date
                    && request.resource.data.score is number
                    && request.resource.data.score >= 0
                    && request.resource.data.score <= 600;
      allow update: if false; // Scores are immutable once submitted
      allow delete: if false;
    }
  }
}
