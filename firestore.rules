rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles rules
    match /users/{userId} {
      allow read: if true; // Leaderboards need to be public
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId); // Account self-deletion (deleteUserAccount)
    }

    // Daily scores rules
    match /scores/{scoreId} {
      allow read: if true;
      // One immutable score per user per day:
      // - doc ID must be "{uid}_{date}" and match the payload
      // - score bounded to the legit range: (6 - attempts) * 100 + speed bonus (max 100)
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && scoreId == request.auth.uid + "_" + request.resource.data.date
                    && request.resource.data.score is number
                    && request.resource.data.score >= 0
                    && request.resource.data.score <= 600;
      allow update: if false; // Scores are immutable once submitted
      allow delete: if false;
    }

    // One immutable, shared chart selection per UTC day. The first signed-in
    // player creates it; everyone can read the resulting daily challenge.
    match /dailySongs/{date} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.date == date
                    && request.resource.data.song.id is string
                    && request.resource.data.song.previewUrl is string;
      allow update, delete: if false;
    }

    // Challenge rooms: host owns the room, players own their own scorecard
    match /rooms/{code} {
      allow read: if isAuthenticated();
      allow create: if isOwner(request.resource.data.hostUid)
                    && request.resource.data.songs.size() > 0
                    && request.resource.data.songs.size() <= 50;
      allow update: if isOwner(resource.data.hostUid);
      allow delete: if isOwner(resource.data.hostUid);

      match /players/{userId} {
        allow read: if isAuthenticated();
        // Own doc only, and the total can't exceed 600 per song in the set.
        allow create, update: if isOwner(userId)
                     && request.resource.data.totalScore is number
                     && request.resource.data.totalScore >= 0
                     && request.resource.data.totalScore
                        <= 600 * get(/databases/$(database)/documents/rooms/$(code)).data.songs.size();
        // Leaving a room removes your own scorecard. Delete carries no
        // request.resource, so it can't ride along on the write rule above.
        allow delete: if isOwner(userId);
      }
    }
  }
}
